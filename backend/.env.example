# ==============================================================================
# BACKEND & DATABASE ENVIRONMENT CONFIGURATION
# ==============================================================================

# (Optional) Full MySQL connection string URL. If provided, backend uses this directly.
# DATABASE_URL=mysql://dexqbit_user:dexqbit_password@db:3306/meetup_tracker

# Database host ('localhost' for local, 'db' for Docker, or cloud host)
DB_HOST=localhost

# Port number for MySQL database connection (Default: 3306)
DB_PORT=3306

# Database username for authentication
DB_USER=dexqbit_user

# Password for the database user
DB_PASSWORD=dexqbit_password

# Name of the target MySQL database
DB_NAME=meetup_tracker

# (Optional) Set to 'true' to force SSL connection for cloud databases
# DB_SSL=true

# (Optional) Keyword in DATABASE_URL triggering SSL (Default: 'ssl-mode=')
# DB_SSL_MODE_KEYWORD=ssl-mode=

# (Optional) Domain keyword in DB_HOST triggering SSL (Default: 'aivencloud.com')
# DB_CLOUD_HOST_KEYWORD=aivencloud.com

# Port number on which the Express backend server listens
PORT=5000

# Node application execution environment ('development', 'production', or 'test')
NODE_ENV=development

# Secret key used to sign and verify JSON Web Tokens (JWT) for user authentication
JWT_SECRET=super_secret_jwt_key_dexqbit_2026_meetup_tracker

# Expiration period for issued JWT authentication tokens (e.g., '7d', '24h', '3600s')
JWT_EXPIRES_IN=7d