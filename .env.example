# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# (Optional) Full MySQL connection string URL. If provided, backend uses this directly.
# Format: mysql://<user>:<password>@<host>:<port>/<database_name>?<options>
# DATABASE_URL=mysql://dexqbit_user:dexqbit_password@db:3306/meetup_tracker

# Hostname or IP address of the MySQL database server (e.g., 'localhost', 'db' for Docker, or cloud host)
DB_HOST=db

# Port number for MySQL database connection (Default: 3306)
DB_PORT=3306

# Database username for authentication
DB_USER=dexqbit_user

# Password for the database user
DB_PASSWORD=dexqbit_password

# Name of the target MySQL database
DB_NAME=meetup_tracker

# Root superuser password for initializing local MySQL Docker container (Used in docker-compose.yml only)
MYSQL_ROOT_PASSWORD=root_password

# (Optional) Explicitly enable SSL for MySQL connection pool (Set to 'true' if required by cloud database)
# DB_SSL=true

# (Optional) Keyword inside DATABASE_URL triggering SSL requirement (Default: 'ssl-mode=')
# DB_SSL_MODE_KEYWORD=ssl-mode=

# (Optional) Domain keyword in DB_HOST triggering automatic SSL requirement (Default: 'aivencloud.com')
# DB_CLOUD_HOST_KEYWORD=aivencloud.com

# ==============================================================================
# BACKEND CONFIGURATION
# ==============================================================================

# Port number on which the Express backend server listens
PORT=5000

# Node application execution environment ('development', 'production', or 'test')
NODE_ENV=development

# Secret key used to sign and verify JSON Web Tokens (JWT) for user authentication
JWT_SECRET=super_secret_jwt_key_dexqbit_2026_meetup_tracker

# Expiration period for issued JWT authentication tokens (e.g., '7d', '24h', '3600s')
JWT_EXPIRES_IN=7d

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================

# Public API base endpoint URL used by Next.js frontend to send client-side HTTP requests
NEXT_PUBLIC_API_URL=http://localhost:5000/api
